<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== "undefined" ? title + " · Task Manager" : "Task Manager" %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="/dashboard">Task Manager</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <% if (currentUser) { %>
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/tasks">Tasks</a></li>
                    <li class="nav-item"><a class="nav-link" href="/products">Products</a></li>
                    <% if (currentUser.role === "admin") { %>
                        <li class="nav-item"><a class="nav-link" href="/admin/materials">Inventory</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/users">Users</a></li>
                        <li class="nav-item"><a class="nav-link" href="/admin/analytics">Analytics</a></li>
                    <% } %>
                </ul>
                <span class="navbar-text me-3 text-light">
                    <%= currentUser.name %> <span class="badge bg-secondary"><%= currentUser.role %></span>
                </span>
                <form action="/logout" method="POST" class="d-flex m-0">
                    <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
                </form>
            <% } else { %>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
                </ul>
            <% } %>
        </div>
    </div>
</nav>
<div class="container pb-5">
    <% if (typeof success !== "undefined" && success && success.length) { %>
        <% success.forEach(function (msg) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% }); %>
    <% } %>
    <% if (typeof error !== "undefined" && error && error.length) { %>
        <% error.forEach(function (msg) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% }); %>
    <% } %>
