<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><%= product.name %> <small class="text-muted"><%= product.sku %></small></h3>
    <% if (currentUser.role === 'admin') { %>
        <a href="/products/<%= product._id %>/edit" class="btn btn-outline-primary">Edit</a>
    <% } %>
</div>
<p><%= product.description || 'No description.' %></p>
<p><strong>Units produced so far:</strong> <%= product.stockQuantity %></p>
<p><strong>Status:</strong> <%= product.isActive ? 'Active' : 'Inactive' %></p>
<h5 class="mt-4">Recipe (raw material needed per 1 unit)</h5>
<table class="table table-striped bg-white shadow-sm">
    <thead><tr><th>Material</th><th>SKU</th><th>Qty per Unit</th><th>Current Stock</th></tr></thead>
    <tbody>
        <% product.materials.forEach(function (m) { %>
        <tr>
            <td><%= m.material.name %></td>
            <td><%= m.material.sku %></td>
            <td><%= m.quantityPerUnit %> <%= m.material.unit %></td>
            <td><%= m.material.quantity %> <%= m.material.unit %></td>
        </tr>
        <% }); %>
    </tbody>
</table>
<a href="/products" class="btn btn-link">Back to Products</a>
<%- include('../partials/footer') %>
