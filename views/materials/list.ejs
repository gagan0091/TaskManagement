<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Inventory (Raw Materials)</h3>
    <a href="/admin/materials/new" class="btn btn-primary">+ New Material</a>
</div>
<div class="mb-3">
    <a href="/admin/materials" class="btn btn-sm btn-outline-secondary <%= !lowStockOnly ? 'active' : '' %>">All</a>
    <a href="/admin/materials?lowStock=true" class="btn btn-sm btn-outline-danger <%= lowStockOnly ? 'active' : '' %>">Low Stock Only</a>
</div>
<div class="table-responsive">
<table class="table table-striped bg-white shadow-sm">
    <thead>
        <tr><th>Name</th><th>SKU</th><th>Stock</th><th>Min Level</th><th>Cost/Unit</th><th>Actions</th></tr>
    </thead>
    <tbody>
        <% materials.forEach(function (m) { %>
        <tr class="<%= m.quantity <= m.minStockLevel ? 'table-danger' : '' %>">
            <td><%= m.name %></td>
            <td><%= m.sku %></td>
            <td><%= m.quantity %> <%= m.unit %></td>
            <td><%= m.minStockLevel %> <%= m.unit %></td>
            <td><%= m.costPerUnit %></td>
            <td class="text-nowrap">
                <a href="/admin/materials/<%= m._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a href="/admin/materials/<%= m._id %>/add-stock" class="btn btn-sm btn-outline-success">Add Stock</a>
                <a href="/admin/materials/<%= m._id %>/adjust-stock" class="btn btn-sm btn-outline-warning">Adjust</a>
                <a href="/admin/materials/<%= m._id %>/history" class="btn btn-sm btn-outline-info">History</a>
                <form action="/admin/materials/<%= m._id %>?_method=DELETE" method="POST" class="d-inline"
                      onsubmit="return confirm('Delete this raw material?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
        <% }); %>
    </tbody>
</table>
</div>
<%- include('../partials/pagination', { pagination: pagination, extraQuery: lowStockOnly ? '&lowStock=true' : '' }) %>
<%- include('../partials/footer') %>
