<%- include('../partials/header') %>
<h3 class="mb-1">Stock History</h3>
<p class="text-muted"><%= material.name %> (<%= material.sku %>) — current: <%= material.quantity %> <%= material.unit %></p>
<div class="table-responsive">
<table class="table table-striped bg-white shadow-sm">
    <thead>
        <tr><th>Date</th><th>Type</th><th>Change</th><th>Balance After</th><th>Task</th><th>By</th><th>Note</th></tr>
    </thead>
    <tbody>
        <% history.forEach(function (h) { %>
        <tr>
            <td><%= new Date(h.createdAt).toLocaleString() %></td>
            <td><span class="badge bg-secondary"><%= h.type %></span></td>
            <td class="<%= h.quantityChange < 0 ? 'text-danger' : 'text-success' %>">
                <%= h.quantityChange > 0 ? '+' : '' %><%= h.quantityChange %>
            </td>
            <td><%= h.balanceAfter %></td>
            <td><% if (h.task) { %><a href="/tasks/<%= h.task._id %>"><%= h.task.title %></a><% } else { %>—<% } %></td>
            <td><%= h.performedBy ? h.performedBy.name : '—' %></td>
            <td><%= h.note || '' %></td>
        </tr>
        <% }); %>
    </tbody>
</table>
</div>
<%- include('../partials/pagination', { pagination: pagination, extraQuery: '' }) %>
<a href="/admin/materials" class="btn btn-link">Back to Inventory</a>
<%- include('../partials/footer') %>
