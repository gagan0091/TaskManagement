<%- include('../partials/header') %>
<h3 class="mb-4"><%= task ? 'Edit' : 'New' %> Task</h3>
<form method="POST" action="<%= task ? ('/tasks/' + task._id + '?_method=PUT') : '/tasks' %>">
    <div class="mb-3">
        <label class="form-label">Title</label>
        <input type="text" name="title" class="form-control" value="<%= task ? task.title : '' %>" required>
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="2"><%= task ? (task.description || '') : '' %></textarea>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Priority</label>
            <select name="priority" class="form-select">
                <% ["low", "medium", "high"].forEach(function (p) { %>
                    <option value="<%= p %>" <%= task && task.priority === p ? 'selected' : '' %>><%= p %></option>
                <% }); %>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Due Date</label>
            <input type="date" name="dueDate" class="form-control"
                   value="<%= task && task.dueDate ? new Date(task.dueDate).toISOString().slice(0,10) : '' %>">
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Assign To</label>
            <select name="assignedTo" class="form-select" required>
                <% users.forEach(function (u) { %>
                    <option value="<%= u._id %>" <%= task && task.assignedTo._id === u._id ? 'selected' : '' %>><%= u.name %></option>
                <% }); %>
            </select>
        </div>
    </div>

    <% if (!task) { %>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Product to Build</label>
            <select name="product" class="form-select" required>
                <option value="">Select product...</option>
                <% products.forEach(function (p) { %>
                    <option value="<%= p._id %>"><%= p.name %> (<%= p.materials.length %> materials)</option>
                <% }); %>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Quantity to Produce</label>
            <input type="number" min="1" step="1" name="quantity" class="form-control" required>
        </div>
    </div>
    <p class="text-muted">Raw material required will be calculated and deducted from inventory automatically.</p>
    <% } else { %>
    <p class="text-muted">Product and quantity are locked once a task is created, because inventory is already
        allocated. Delete this task (which reverts inventory) and create a new one if that needs to change.</p>
    <% } %>

    <button type="submit" class="btn btn-primary">Save Task</button>
    <a href="/tasks" class="btn btn-link">Cancel</a>
</form>
<%- include('../partials/footer') %>
