PORT=5000

# Docker: set automatically by docker-compose.yml
# Local (API outside docker, Mongo in docker):
# MONGO_URI=mongodb://localhost:27017/task_management?directConnection=true
MONGO_URI=mongodb://mongo:27017/task_management?replicaSet=rs0

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Used by the EJS frontend's session cookie (separate from the API's JWT)
SESSION_SECRET=change_me_too

# Base URL the EJS frontend uses to call its OWN JSON API (loopback).
# Only change this if the app runs behind a different host/port internally.
APP_BASE_URL=http://localhost:5000


